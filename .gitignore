# ================================================
# GitHub 100MB 제한 회피 — Vuforia 패키지 제외
# ================================================

# Vuforia Engine 패키지(tgz 압축 파일) — 반드시 제외!
[Pp]ackages/com.ptc.vuforia.engine/
[Pp]ackages/**/*.*.tgz

# ================================================
# Unity 패키지 캐시 (다운로드 가능하므로 제외)
# ================================================

[Pp]ackages/*/*/package.json.copy
[Pp]ackages/*/*/Documentation~
[Pp]ackages/*/*/Samples~

# ================================================
# Unity Addressables (빌드 파일은 제외)
# ================================================

[Aa]ssets/[Aa]ddressable[Aa]ssetsData/*/*.bin
[Aa]ssets/[Aa]ddressable[Aa]ssetsData/*/*.hash
[Aa]ssets/[Aa]ddressable[Aa]ssetsData/*/*.json

# ================================================
# 빌드 산출물
# ================================================

*.apk
*.aab
*.unitypackage
